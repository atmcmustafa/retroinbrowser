NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# https://www.steamgriddb.com/profile/preferences/api
STEAMGRIDDB_API_KEY=

# Cloudflare > Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cache refresh for scripts/SQL edits: POST /api/revalidate with "Authorization: Bearer <secret>"
REVALIDATE_SECRET=

# Google and Discord OAuth apps (docs/SETUP.md 3). Only `npm run db:config -- push` reads these
# to configure Supabase Auth; the app doesn't, so they don't go to Vercel.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=
