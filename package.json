{
  "name": "retroinbrowser",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/database.ts && prettier --write src/types/database.ts",
    "db:push": "supabase db push",
    "db:new": "supabase migration new",
    "db:config": "tsx scripts/supabase-config.ts",
    "artwork": "tsx --conditions=react-server --env-file=.env.local scripts/fill-artwork.ts",
    "collect": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/collect.ts",
    "extract": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/extract.ts",
    "check-links": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/check-links.ts",
    "indexnow": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/indexnow.ts",
    "test:scripts": "tsx --test \"scripts/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@hookform/resolvers": "^6.0.1",
    "@marsidev/react-turnstile": "^1.6.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "nuqs": "^2.10.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
